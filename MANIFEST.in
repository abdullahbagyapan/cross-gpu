include LICENSE
include README.md
include CHANGELOG.md
include Makefile
include pyproject.toml
include cross-gpu
recursive-include completions *
recursive-include docs *
recursive-include src *.py
recursive-include src/kernels *.cu *.hip *.cl *.metal README.md
recursive-include tests *.py
prune build
prune dist
prune .git
global-exclude __pycache__ *.py[co] .DS_Store
